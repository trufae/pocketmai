{
  "name": "orders-service",
  "server": {
    "host": "0.0.0.0",
    "port": 3000,
    "keepAliveSeconds": 65,
    "maxBodyBytes": 1048576
  },
  "database": {
    "url": "postgres://orders@db:5432/orders",
    "pool": {
      "min": 2,
      "max": 20
    },
    "sslMode": "require"
  },
  "cache": {
    "backend": "redis",
    "url": "redis://cache:6379/0",
    "ttlSeconds": 300
  },
  "features": {
    "newCheckout": true,
    "asyncEmails": false,
    "betaReports": false
  },
  "logging": {
    "level": "info",
    "format": "json",
    "destinations": [
      "stdout",
      "/var/log/orders.log"
    ]
  },
  "rateLimits": [
    {
      "path": "/api/orders",
      "perMinute": 600
    },
    {
      "path": "/api/login",
      "perMinute": 30
    }
  ],
  "cors": {
    "origins": [
      "https://shop.example.com",
      "https://admin.example.com"
    ],
    "credentials": true
  },
  "metrics": {
    "enabled": true,
    "port": 9100,
    "path": "/metrics"
  },
  "secretsProvider": "vault"
}
